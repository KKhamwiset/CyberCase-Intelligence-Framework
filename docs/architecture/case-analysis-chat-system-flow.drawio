        <mxCell id="e22" edge="1" parent="1" source="chatResponse" target="front" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e23" value="same response handling" edge="1" parent="1" source="ordinaryOut" target="front" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e24" value="same response handling" edge="1" parent="1" source="nextMsg" target="front" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e25" value="writes/reads" edge="1" parent="1" source="answerRow" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e26" value="writes" edge="1" parent="1" source="storeChat" target="db" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e27" value="return cached result" edge="1" parent="1" source="replay" target="front" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
