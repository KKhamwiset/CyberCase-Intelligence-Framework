        <mxCell id="trace" value="CaseAnalysisTrace&lt;br&gt;summary&lt;br&gt;involved_parties[] / timeline[]&lt;br&gt;claims[] / impacts[] / gaps[]&lt;br&gt;mitre_associations[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="920" y="910" width="270" height="150" as="geometry"/></mxCell>
        <mxCell id="bind" value="bind_to_case()&lt;br&gt;ตรวจ claim/source/citation&lt;br&gt;ตัด citation ที่ไม่ตรง exact quote&lt;br&gt;bind page metadata&lt;br&gt;สร้าง grounding report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="570" y="905" width="270" height="160" as="geometry"/></mxCell>
        <mxCell id="storeV" value="store_analysis()&lt;br&gt;insert status=validated&lt;br&gt;trace_json + pipeline_config&lt;br&gt;external/retrieval context metadata&lt;br&gt;set latest_analysis_result_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="220" y="900" width="280" height="170" as="geometry"/></mxCell>
        <mxCell id="outV" value="AnalysisStepRead completed&lt;br&gt;result=CaseAnalysisResultRead&lt;br&gt;freshness=current" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="220" y="1170" width="280" height="95" as="geometry"/></mxCell>
        <mxCell id="frontV" value="useStartCaseAnalysis.onSuccess&lt;br&gt;set analysis query cache&lt;br&gt;invalidate Case + Cases&lt;br&gt;refetch Chat&lt;br&gt;Overview components render trace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="1145" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="get" value="GET /cases/{id}/analysis&lt;br&gt;คืนเฉพาะ latest validated result&lt;br&gt;assessment ไม่ถูกเปิดเป็นผลสำเร็จ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="980" y="1160" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="f1" target="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="a1" target="w1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="w1" target="snap" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
