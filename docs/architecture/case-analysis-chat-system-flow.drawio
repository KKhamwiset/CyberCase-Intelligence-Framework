  <diagram id="chat" name="3 - Chat and Follow-up Detail">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1500" math="0" shadow="0" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Chat / Follow-up System: Routing, Persistence, Re-analysis, Frontend" style="text;html=1;fontSize=24;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="20" width="1350" height="50" as="geometry"/></mxCell>
        <mxCell id="load" value="WorkspaceChatPanel&lt;br&gt;useCaseChat({ caseId })" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="260" height="85" as="geometry"/></mxCell>
        <mxCell id="get" value="GET /cases/{id}/chat&lt;br&gt;CaseChatRead { status, messages[] }" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="380" y="110" width="290" height="85" as="geometry"/></mxCell>
        <mxCell id="render" value="ChatTranscript&lt;br&gt;เรียงด้วย ordinal&lt;br&gt;gap_key != null → แสดง One more detail&lt;br&gt;openQuestionId() หา pending question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="740" y="90" width="310" height="125" as="geometry"/></mxCell>
        <mxCell id="compose" value="ผู้ใช้ส่งข้อความ&lt;br&gt;content + crypto.randomUUID()&lt;br&gt;response_language auto-detected" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="100" width="300" height="105" as="geometry"/></mxCell>
        <mxCell id="post" value="POST /cases/{id}/chat/messages&lt;br&gt;ChatMessageCreate&lt;br&gt;content, client_request_id, response_language" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1490" y="95" width="330" height="115" as="geometry"/></mxCell>
        <mxCell id="router" value="routers/chat.py&lt;br&gt;create_case_chat_message()&lt;br&gt;→ post_case_message()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="1880" y="105" width="260" height="95" as="geometry"/></mxCell>
        <mxCell id="retry" value="client_request_id&lt;br&gt;เคยถูกบันทึกแล้ว?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1835" y="290" width="340" height="140" as="geometry"/></mxCell>
        <mxCell id="replay" value="messages_of_send()&lt;br&gt;คืน messages เดิม&lt;br&gt;ไม่สร้างข้อมูลซ้ำ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1510" y="315" width="250" height="95" as="geometry"/></mxCell>
        <mxCell id="pending" value="standing_question()&lt;br&gt;pending_question():&lt;br&gt;มี ChatMessage ที่ gap_key != null&lt;br&gt;และยังไม่มี reply หรือไม่?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1815" y="510" width="370" height="170" as="geometry"/></mxCell>
        <mxCell id="ordinary" value="เส้นทาง Chat ปกติ&lt;br&gt;reply_in_conversation()&lt;br&gt;→ answer_case_question()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1430" y="540" width="290" height="105" as="geometry"/></mxCell>
        <mxCell id="context" value="สร้าง answer context&lt;br&gt;มี latest analysis → trace + summary + history&lt;br&gt;ไม่มี analysis → sources + history&lt;br&gt;เก็บ user conversation ก่อน LLM call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1030" y="525" width="310" height="135" as="geometry"/></mxCell>
        <mxCell id="answerLlm" value="generate_case_answer()&lt;br&gt;หรือ generate_pre_analysis_answer()&lt;br&gt;หนึ่ง structured LLM call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="690" y="535" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="storeChat" value="เก็บ assistant conversation&lt;br&gt;in_reply_to_message_id=user message&lt;br&gt;analysis_result_id ตาม context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="350" y="535" width="270" height="110" as="geometry"/></mxCell>
        <mxCell id="ordinaryOut" value="CaseChatResponse&lt;br&gt;messages=[user, assistant]&lt;br&gt;analysis=null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="record" value="เส้นทาง Follow-up answer&lt;br&gt;record_answer_and_ask_next()&lt;br&gt;lock Case + re-check pending question" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1815" y="780" width="360" height="115" as="geometry"/></mxCell>
        <mxCell id="answerRow" value="insert ChatMessage&lt;br&gt;role=user&lt;br&gt;message_kind=followup_answer&lt;br&gt;analysis_result_id=question.analysis_result_id&lt;br&gt;in_reply_to_message_id=question.id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1440" y="755" width="300" height="165" as="geometry"/></mxCell>
        <mxCell id="next" value="next_question_of_round()&lt;br&gt;อ่าน gaps จาก assessment/trace เดิม&lt;br&gt;decide_followup() ด้วย asked_this_round" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="750" width="340" height="175" as="geometry"/></mxCell>
        <mxCell id="nextMsg" value="ยังมี gap ในรอบเดิม&lt;br&gt;insert followup_question ถัดไป&lt;br&gt;CaseChatResponse.messages&lt;br&gt;analysis=null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="760" width="290" height="145" as="geometry"/></mxCell>
        <mxCell id="after" value="รอบเดิมหมด&lt;br&gt;analyse_after_round()&lt;br&gt;run_case_analysis(continuing_followup=True)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="1040" width="340" height="120" as="geometry"/></mxCell>
        <mxCell id="history" value="load_followup_history()&lt;br&gt;สร้าง CaseFollowupExchange[]&lt;br&gt;QA-01, gap_key, question, answer&lt;br&gt;คำตอบไม่เพิ่ม source_revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="1450" y="1025" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="analysisAgain" value="Analysis assess ใหม่&lt;br&gt;อาจ Ask รอบใหม่ หรือ Proceed ไป Full Analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="650" y="1045" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="chatResponse" value="CaseChatResponse&lt;br&gt;messages = ตั้งแต่ answer ล่าสุด&lt;br&gt;analysis = validated result เฉพาะเมื่อ completed&lt;br&gt;ถ้า need_followup → analysis=null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="1025" width="310" height="145" as="geometry"/></mxCell>
        <mxCell id="front" value="useCaseChat.onSuccess&lt;br&gt;merge/dedupe messages ใน chat cache&lt;br&gt;ถ้า result.analysis มีค่า:&lt;br&gt;set analysis cache + Case cache&lt;br&gt;invalidate Case list/background reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="1005" width="300" height="175" as="geometry"/></mxCell>
        <mxCell id="db" value="PostgreSQL&lt;br&gt;chat_messages&lt;br&gt;case_analysis_results&lt;br&gt;cases.latest_analysis_result_id" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="1820" y="1050" width="260" height="125" as="geometry"/></mxCell>
        <mxCell id="note" value="Boundary สำคัญ: follow-up answer เป็น conversation ที่ Analysis อ่านได้และอ้างเป็น QA-* ได้ แต่ไม่ใช่ Case source และไม่ขยับ source_revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="440" y="1300" width="1300" height="65" as="geometry"/></mxCell>
        <mxCell id="e1" edge="1" parent="1" source="load" target="get" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" edge="1" parent="1" source="get" target="render" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="render" target="compose" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" edge="1" parent="1" source="compose" target="post" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" edge="1" parent="1" source="post" target="router" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" edge="1" parent="1" source="router" target="retry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="ใช่" edge="1" parent="1" source="retry" target="replay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="ไม่" edge="1" parent="1" source="retry" target="pending" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="ไม่มี" edge="1" parent="1" source="pending" target="ordinary" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" edge="1" parent="1" source="ordinary" target="context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" edge="1" parent="1" source="context" target="answerLlm" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e12" edge="1" parent="1" source="answerLlm" target="storeChat" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e13" edge="1" parent="1" source="storeChat" target="ordinaryOut" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e14" value="มี" edge="1" parent="1" source="pending" target="record" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e15" edge="1" parent="1" source="record" target="answerRow" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e16" edge="1" parent="1" source="answerRow" target="next" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e17" value="มี" edge="1" parent="1" source="next" target="nextMsg" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e18" value="ไม่มี" edge="1" parent="1" source="next" target="after" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e19" edge="1" parent="1" source="after" target="history" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e20" edge="1" parent="1" source="history" target="analysisAgain" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
