        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Architecture Interfaces, State Ownership, and Outputs" style="text;html=1;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="470" y="20" width="1260" height="55" as="geometry"/></mxCell>
        <mxCell id="front" value="Frontend owns&lt;br&gt;• visible workspace state&lt;br&gt;• React Query caches&lt;br&gt;• pending UI send&lt;br&gt;• opening Ask panel&lt;br&gt;&lt;br&gt;Does not own&lt;br&gt;• follow-up policy&lt;br&gt;• analysis truth&lt;br&gt;• round counters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="330" height="260" as="geometry"/></mxCell>
        <mxCell id="analysisApi" value="Analysis Interface&lt;br&gt;&lt;br&gt;POST /analysis&lt;br&gt;CaseAnalysisCreate&lt;br&gt;→ AnalysisStepRead&lt;br&gt;&lt;br&gt;GET /analysis&lt;br&gt;→ latest validated CaseAnalysisResultRead | null" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="120" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="chatApi" value="Chat Interface&lt;br&gt;&lt;br&gt;GET /chat&lt;br&gt;→ CaseChatRead&lt;br&gt;&lt;br&gt;POST /chat/messages&lt;br&gt;ChatMessageCreate&lt;br&gt;→ CaseChatResponse&lt;br&gt;messages[] + optional validated analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="940" y="120" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="backend" value="Backend owns&lt;br&gt;• deterministic Follow-up policy&lt;br&gt;• round and gap budgets&lt;br&gt;• request-scoped model execution&lt;br&gt;• source/quote binding&lt;br&gt;• latest validated result pointer&lt;br&gt;• message ordering/idempotency&lt;br&gt;&lt;br&gt;No run/job row and no polling" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1390" y="110" width="390" height="300" as="geometry"/></mxCell>
        <mxCell id="assessment" value="Assessment state&lt;br&gt;CaseAnalysisResult.status=assessment&lt;br&gt;trace_json=CaseAssessmentTrace&lt;br&gt;&lt;br&gt;Purpose&lt;br&gt;• preserve gaps for current round&lt;br&gt;• bind questions to analysis_result_id&lt;br&gt;&lt;br&gt;Never becomes latest visible analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="250" y="560" width="360" height="260" as="geometry"/></mxCell>
        <mxCell id="messages" value="Conversation state&lt;br&gt;ChatMessage&lt;br&gt;&lt;br&gt;message_kind&lt;br&gt;• conversation&lt;br&gt;• followup_question&lt;br&gt;• followup_answer&lt;br&gt;&lt;br&gt;Links&lt;br&gt;gap_key / analysis_result_id&lt;br&gt;in_reply_to_message_id&lt;br&gt;client_request_id" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="700" y="535" width="360" height="310" as="geometry"/></mxCell>
        <mxCell id="validated" value="Validated analysis state&lt;br&gt;CaseAnalysisResult.status=validated&lt;br&gt;Case.latest_analysis_result_id → result&lt;br&gt;&lt;br&gt;Contains&lt;br&gt;answer / summary / CaseAnalysisTrace&lt;br&gt;pipeline config / context metadata&lt;br&gt;retrieval context snapshot&lt;br&gt;&lt;br&gt;Consumed by Overview, Chat and Reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1150" y="530" width="410" height="320" as="geometry"/></mxCell>
        <mxCell id="sources" value="Authoritative Case Sources&lt;br&gt;Case narrative + admitted documents&lt;br&gt;Case.source_revision&lt;br&gt;&lt;br&gt;Used for&lt;br&gt;• assessment&lt;br&gt;• main analysis&lt;br&gt;• grounding and citations&lt;br&gt;• pre-analysis chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1600" y="535" width="360" height="280" as="geometry"/></mxCell>
        <mxCell id="followup" value="Follow-up Q/A&lt;br&gt;Derived as CaseFollowupExchange&lt;br&gt;qa_id=QA-* + question + answer&lt;br&gt;&lt;br&gt;Supplied beside CaseSourceBundle&lt;br&gt;Can support later claims&lt;br&gt;Does not enter case_sources&lt;br&gt;Does not increment source_revision" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="500" y="970" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="external" value="External Technical Context&lt;br&gt;MITRE ATT&amp;CK via rag_service&lt;br&gt;retrieval_context_id + context&lt;br&gt;&lt;br&gt;Conditional augmentation only&lt;br&gt;Never treated as incident fact&lt;br&gt;Failure does not block general analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1040" y="970" width="400" height="250" as="geometry"/></mxCell>
        <mxCell id="output" value="Frontend-visible outputs&lt;br&gt;&lt;br&gt;Analysis paused&lt;br&gt;AnalysisStepRead.need_followup → Chat question&lt;br&gt;&lt;br&gt;Analysis complete&lt;br&gt;CaseAnalysisResultRead → Overview/cache&lt;br&gt;&lt;br&gt;Chat send&lt;br&gt;CaseChatResponse → transcript&lt;br&gt;+ optional completed analysis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="1570" y="940" width="410" height="300" as="geometry"/></mxCell>
        <mxCell id="rule" value="Core architectural rule: semantic interpretation is delegated to the LLM; validation, routing, priority, budgets, persistence, and stopping are deterministic backend responsibilities." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;strokeWidth=2;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="380" y="1340" width="1440" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" value="typed HTTP" edge="1" parent="1" source="front" target="analysisApi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="typed HTTP" edge="1" parent="1" source="front" target="chatApi" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" edge="1" parent="1" source="analysisApi" target="backend" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
