        <mxCell id="e5" value="Ask path" edge="1" parent="1" source="backend" target="assessment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="creates question" edge="1" parent="1" source="assessment" target="messages" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
