# Version control metadata
.git
.git/**
.gitignore
.gitattributes

# Generated Python files and local tooling state
**/__pycache__/
**/*.py[cod]
**/*$py.class
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/.coverage.*
**/htmlcov/
**/.tox/
**/.nox/
**/.venv/
**/venv/
**/env/
**/env_*/
**/*.egg-info/
**/build/
**/dist/

# Tests, benchmarks, and training material
**/test/
**/tests/
**/test_*.py
**/*_test.py
**/benchmark/
**/benchmarks/
**/*benchmark*
**/train/
**/training/
**/finetune/
**/*training*

# Documentation and reports
**/docs/
**/*.md
**/*.rst
**/*.adoc
**/*.html
**/*.pdf
**/*.doc
**/*.docx
**/report/
**/reports/
**/*report*.json
**/*report*.jsonl
**/*report*.csv

# Evaluation code and the standalone GraphRAG CLI
app/RAG/GraphRAG/evaluation/
app/RAG/GraphRAG/main.py
app/_perf_probe.py

# Datasets and incident artifacts
**/dataset/
**/datasets/
**/*dataset*.json
**/*dataset*.jsonl
**/*dataset*.csv
**/incident/
**/incidents/
**/*incident*.json
**/*incident*.jsonl
**/*incident*.csv

# Local caches and model artifacts (the image cache is generated at /app/model_cache)
**/.cache/
**/cache/
**/model_cache/
**/.model_cache/
**/.huggingface/
**/huggingface/
**/hf_cache/
**/*.safetensors
**/*.bin
**/*.pt
**/*.pth
**/*.onnx
**/*.ckpt
**/*.gguf
**/*.pickle
**/*.pkl

# Secrets and credential-like files
**/.env
**/.env.*
**/*.env
**/*secret*
**/*credential*
**/*credentials*
**/*token*
**/*password*
**/*passwd*
**/*.pem
**/*.key
**/*.crt
**/*.cer
**/*.p12
**/*.pfx
**/*.der
