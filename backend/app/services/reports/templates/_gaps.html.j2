<section class="report-section">
    <div class="section-header">
        <h2 class="section-number-title">{{ report.i18n.sec_5 }}</h2>
    </div>

    <div class="sub-header">{{ report.i18n.sub_unresolved }}</div>
    <ul class="item-list">
        {% for issue in report.unresolved_issues %}
        <li>
            <strong>{{ issue.description }}</strong>
            {% if issue.reason and issue.reason != '-' %}
            <div class="text-muted">{{ issue.reason }}</div>
            {% endif %}
        </li>
        {% endfor %}
    </ul>

    <div class="section-header" style="margin-top: 14pt;">
        <h2 class="section-number-title">{{ report.i18n.sec_6 }}</h2>
    </div>

    <div class="sub-header">{{ report.i18n.sub_next_steps }}</div>
    <ol class="item-list">
        {% for action in report.verification_actions %}
        <li>{{ action.action }}</li>
        {% endfor %}
    </ol>
</section>
