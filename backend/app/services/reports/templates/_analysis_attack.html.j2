<section class="report-section">
    <div class="section-header">
        <h2 class="section-number-title">{{ report.i18n.sec_4 }}</h2>
    </div>

    {% if report.has_mitre_mappings %}
    <p class="section-lead-paragraph text-muted">{{ report.i18n.sub_mitre_intro }}</p>
    <div class="mitre-cards-container">
        {% for row in report.mitre_rows %}
        <div class="mitre-card">
            <div class="mitre-card-header">
                <strong>{{ row.technique_id }} — {{ row.technique_name }}</strong>
                <span class="mitre-card-tactic">Tactic: {{ row.tactic }}</span>
            </div>
            <div class="mitre-card-body">
                <div><strong>{{ report.i18n.col_case_support }}:</strong> {{ row.case_evidence_support }}</div>
                <div class="mitre-card-status"><strong>{{ report.i18n.col_mapping_status }}:</strong> {{ row.status_display }}</div>
            </div>
        </div>
        {% endfor %}
    </div>
    {% else %}
    <p class="section-lead-paragraph text-muted">{{ report.i18n.empty_mitre }}</p>
    {% endif %}
</section>
