<!doctype html>
<html lang="th">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ report.title }}</title>
  <style>
    @page { size: A4; margin: 18mm 16mm 16mm; }
    :root { color-scheme: light; font-family: "Noto Sans Thai", "Garuda", "Tahoma", sans-serif; color: #111827; background: #f9fafb; }
    * { box-sizing: border-box; }
    body { margin: 0; background: #f9fafb; color: #111827; font-size: 13.5px; line-height: 1.75; }
    .document { width: min(100%, 880px); margin: 0 auto; padding: 36px 32px 48px; background: #ffffff; }
    .eyebrow { margin: 0 0 6px; color: #4b5563; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; }
    h1 { margin: 0; color: #1e293b; font-size: 24px; line-height: 1.3; }
    .report-type { margin: 6px 0 16px; color: #4b5563; font-size: 13.5px; font-weight: 600; }
    .meta-table { width: 100%; border-collapse: collapse; margin-bottom: 20px; font-size: 12.5px; }
    .meta-table td { padding: 8px 12px; border: 1px solid #d1d5db; background: #f3f4f6; color: #111827; }
    .meta-table strong { color: #4b5563; }
    .formal-rule { border: 0; border-top: 1.5px solid #1e293b; margin: 18px 0 22px; }
    .report-section { margin-top: 24px; break-inside: avoid; }
    .report-section h2, .source-register h2 { margin: 0 0 12px; padding: 6px 12px; border: 1px solid #d1d5db; background: #f3f4f6; color: #1e293b; font-size: 15px; line-height: 1.4; font-weight: 700; }
    .paragraph { margin: 0 0 8px; white-space: pre-wrap; }
    .body-indent { text-indent: 24px; }
    .summary-subhead { margin: 14px 0 6px; font-size: 13.5px; font-weight: 700; color: #1e293b; }
    .formal-bullet { margin: 4px 0 4px 12px; line-height: 1.65; }
    .purpose-block { margin: 0 0 12px; padding: 8px 12px; border: 1px solid #d1d5db; background: #f9fafb; font-size: 13px; line-height: 1.6; }
    .indicator-list { display: flex; flex-direction: column; gap: 14px; margin-top: 10px; }
    .indicator-formal { padding: 10px 14px; border-bottom: 1px solid #e5e7eb; background: #ffffff; break-inside: avoid; }
    .indicator-title { color: #1e293b; font-size: 14px; margin-bottom: 4px; }
    .epistemic-tag { color: #4b5563; font-style: italic; font-size: 12px; font-weight: normal; margin-left: 6px; }
    .claim-text { margin: 0 0 6px; }
    .formal-quote { margin: 4px 0 4px 20px; font-style: italic; color: #4b5563; font-size: 13px; }
    .quote-contradict { color: #991b1b; }
    .formal-reasoning { margin: 4px 0 4px 20px; font-style: italic; color: #1e3a8a; font-size: 13px; }
    .source-register { margin-top: 32px; padding-top: 12px; border-top: 1px solid #d1d5db; }
    .source-register p { margin: 0 0 8px; color: #4b5563; font-size: 12px; }
    .source-row { padding: 3px 0 3px 12px; font-size: 13px; }
    footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #e5e7eb; color: #6b7280; font-size: 11px; text-align: center; }
    @media print {
      body { background: #ffffff; }
      .document { width: auto; padding: 0; }
      .report-section, .source-register { break-inside: auto; }
      .indicator-formal { break-inside: avoid; }
    }
  </style>
</head>
<body>
  <article class="document">
    <header>
      <p class="eyebrow">CYBERCASE INTELLIGENCE FRAMEWORK</p>
      <h1>รายงานสรุปผลการวิเคราะห์คดีเบื้องต้น</h1>
      <p class="report-type">เรื่อง: {{ report.title }}</p>
      <table class="meta-table">
        <tr>
          <td><strong>ประเภทเอกสาร:</strong> รายงานสรุปผลการวิเคราะห์เบื้องต้น</td>
          <td><strong>สถานะ:</strong> เบื้องต้น / ยังไม่ยืนยัน</td>
        </tr>
        <tr>
          <td><strong>เอกสารที่นำเข้า:</strong> {{ display.sources | length }} รายการ</td>
          <td><strong>วัตถุประสงค์:</strong> สำหรับการตรวจสำนวนภายใน</td>
        </tr>
      </table>
      <hr class="formal-rule">
    </header>
    <main>
      {% for section in report.sections %}
      <section class="report-section" id="{{ section.section_id }}">
        <h2>{{ section.heading }}</h2>

        {% if section.section_id == "case_summary" %}
          {% for paragraph in section.paragraphs %}
            {% set p_clean = paragraph | strip_reference_text %}
            {% if p_clean.startswith("วัตถุประสงค์ของรายงาน:") %}
              <div class="purpose-block">
                <strong>วัตถุประสงค์:</strong> {{ p_clean.replace("วัตถุประสงค์ของรายงาน:", "").strip() }}
              </div>
            {% elif p_clean.startswith("สรุปจากผลวิเคราะห์:") %}
              <div class="summary-subhead">สรุปภาพรวมจากผลการวิเคราะห์:</div>
              <p class="paragraph body-indent">{{ p_clean.replace("สรุปจากผลวิเคราะห์:", "").strip() }}</p>
            {% elif p_clean.startswith("ข้อสรุปเบื้องต้น:") %}
              <div class="summary-subhead">ข้อสรุปเบื้องต้น:</div>
              <p class="paragraph body-indent">{{ p_clean.replace("ข้อสรุปเบื้องต้น:", "").strip() }}</p>
            {% else %}
              <p class="paragraph body-indent">{{ p_clean }}</p>
            {% endif %}
          {% endfor %}

          {% set ns_sum = namespace(has_parties=false, has_timeline=false, has_impacts=false, has_others=false) %}
          {% for item in section.items %}
            {% set item_clean = item | strip_reference_text %}
            {% if item_clean.startswith("ผู้เกี่ยวข้อง:") %}
              {% if not ns_sum.has_parties %}
                {% set ns_sum.has_parties = true %}
                <div class="summary-subhead">ผู้เกี่ยวข้องในคดี:</div>
              {% endif %}
              <div class="formal-bullet">• {{ item_clean.replace("ผู้เกี่ยวข้อง:", "").strip() }}</div>
            {% endif %}
          {% endfor %}

          {% for item in section.items %}
            {% set item_clean = item | strip_reference_text %}
            {% if item_clean.startswith("ลำดับเหตุการณ์:") %}
              {% if not ns_sum.has_timeline %}
                {% set ns_sum.has_timeline = true %}
                <div class="summary-subhead">ลำดับเหตุการณ์สำคัญ:</div>
              {% endif %}
              <div class="formal-bullet">• {{ item_clean.replace("ลำดับเหตุการณ์:", "").strip() }}</div>
            {% endif %}
          {% endfor %}

          {% for item in section.items %}
            {% set item_clean = item | strip_reference_text %}
            {% if item_clean.startswith("ผลกระทบที่ปรากฏ:") %}
              {% if not ns_sum.has_impacts %}
                {% set ns_sum.has_impacts = true %}
                <div class="summary-subhead">ความเสียหายและผลกระทบที่ปรากฏ:</div>
              {% endif %}
              <div class="formal-bullet">• {{ item_clean.replace("ผลกระทบที่ปรากฏ:", "").strip() }}</div>
            {% endif %}
          {% endfor %}

          {% for item in section.items %}
            {% set item_clean = item | strip_reference_text %}
            {% if not item_clean.startswith("ผู้เกี่ยวข้อง:") and not item_clean.startswith("ลำดับเหตุการณ์:") and not item_clean.startswith("ผลกระทบที่ปรากฏ:") %}
              {% if not ns_sum.has_others %}
                {% set ns_sum.has_others = true %}
                <div class="summary-subhead">ข้อมูลสรุปเพิ่มเติม:</div>
              {% endif %}
              <div class="formal-bullet">• {{ item_clean }}</div>
            {% endif %}
          {% endfor %}

        {% elif section.section_id == "case_evidence" and display.claims %}
          {% for paragraph in section.paragraphs %}
            <p class="paragraph">{{ paragraph | clean_report_text }}</p>
          {% endfor %}
          <div class="indicator-list">
            {% for claim in display.claims %}
            <article class="indicator-formal">
              <div class="indicator-title">
                <strong>ตัวบ่งชี้ที่ {{ claim.ordinal }}:</strong>
                {% if claim.epistemic_label not in ["ปรากฏในหลักฐาน", "reported"] %}
                  <span class="epistemic-tag">({{ claim.epistemic_label }})</span>
                {% endif %}
              </div>
              <p class="claim-text">{{ claim.text | clean_report_text }}</p>
              {% for quote in claim.supporting_quotes %}
                <div class="formal-quote">ข้อความจากหลักฐาน: “{{ quote }}”</div>
              {% endfor %}
              {% for quote in claim.contradicting_quotes %}
                <div class="formal-quote quote-contradict">ข้อความที่ขัดแย้ง: “{{ quote }}”</div>
              {% endfor %}
              {% if claim.reasoning_summary %}
                <div class="formal-reasoning">เหตุผลเชิงวิเคราะห์: {{ claim.reasoning_summary | clean_report_text }}</div>
              {% endif %}
            </article>
            {% endfor %}
          </div>

        {% elif section.section_id == "preliminary_recommendations" %}
          {% for paragraph in section.paragraphs %}
            <p class="paragraph">{{ paragraph | clean_report_text }}</p>
          {% endfor %}
          {% set ns_rec = namespace(has_specific=false, has_general=false) %}
          {% for item in section.items %}
            {% set item_clean = item | strip_reference_text %}
            {% if item_clean.startswith("ตรวจสอบเพิ่มเติมในประเด็น") %}
              {% if not ns_rec.has_specific %}
                {% set ns_rec.has_specific = true %}
                <div class="summary-subhead">ประเด็นสำคัญที่ควรดำเนินการตรวจสอบเพิ่มเติม:</div>
              {% endif %}
              <div class="formal-bullet">• {{ item_clean.replace("ตรวจสอบเพิ่มเติมในประเด็น", "").strip() }}</div>
            {% endif %}
          {% endfor %}
          {% for item in section.items %}
            {% set item_clean = item | strip_reference_text %}
            {% if not item_clean.startswith("ตรวจสอบเพิ่มเติมในประเด็น") %}
              {% if not ns_rec.has_general %}
                {% set ns_rec.has_general = true %}
                <div class="summary-subhead">แนวทางการปฏิบัติในการรวบรวมพยานหลักฐาน:</div>
              {% endif %}
              <div class="formal-bullet">• {{ item_clean }}</div>
            {% endif %}
          {% endfor %}

        {% else %}
          {% for paragraph in section.paragraphs %}
            <p class="paragraph">{{ paragraph | clean_report_text }}</p>
          {% endfor %}
          {% for item in section.items %}
            <div class="formal-bullet">• {{ item | strip_reference_text }}</div>
          {% endfor %}
        {% endif %}
      </section>
      {% endfor %}

      <section class="source-register">
        <h2>เอกสารที่ใช้ประกอบการวิเคราะห์</h2>
        <p>รายงานฉบับนี้จัดทำขึ้นจากการประมวลผลเอกสารหลักฐานในสำนวนคดีดังต่อไปนี้:</p>
        {% for source in display.sources %}
          <div class="source-row">• {{ source.filename }}</div>
        {% endfor %}
      </section>
    </main>
    <footer>รายงานสรุปผลการวิเคราะห์คดีเบื้องต้น จัดทำโดย CyberCase Intelligence Framework</footer>
  </article>
</body>
</html>
