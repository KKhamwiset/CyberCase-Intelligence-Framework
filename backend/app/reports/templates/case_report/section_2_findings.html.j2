      <section id="case_evidence">
        <h2>2. ข้อเท็จจริงที่ตรวจพบ</h2>
        {% if report.findings %}
          {% set tables.n = tables.n + 1 %}
          <p class="body">ตารางต่อไปนี้แสดงข้อเท็จจริงที่ปรากฏในหลักฐาน พร้อมสถานะการยืนยันและรหัสอ้างอิงหลักฐานตามภาคผนวก ก</p>
          <p class="caption">ตารางที่ {{ tables.n }} ข้อเท็จจริงที่ตรวจพบ</p>
          <table class="formal">
            <colgroup><col style="width: 7%"><col style="width: 63%"><col style="width: 16%"><col style="width: 14%"></colgroup>
            <thead><tr><th>ข้อ</th><th>ข้อเท็จจริง</th><th>สถานะ</th><th>อ้างอิง</th></tr></thead>
            <tbody>
              {% for finding in report.findings %}
              <tr id="finding-{{ finding.ordinal }}">
                <td class="n">{{ finding.ordinal }}</td>
                <td>
                  {{ finding.text | clean_report_text }}
                  {% for quote in finding.supporting_quotes | quoted(finding.supporting_contexts) %}
                    <div class="quote"><span class="quote-label">ข้อความจากหลักฐาน:</span> {{ quote }}</div>
                  {% endfor %}
                  {% for quote in finding.contradicting_quotes | quoted(finding.contradicting_contexts) %}
                    <div class="quote"><span class="quote-label">ข้อความที่ขัดแย้ง:</span> {{ quote }}</div>
                  {% endfor %}
                  {% for item in finding.unverified_quotes %}
                    <div class="quote"><span class="quote-label">ไม่สามารถระบุตำแหน่งหลักฐานที่อ้างอิงได้</span></div>
                  {% endfor %}
                </td>
                <td>
                  {{ finding.status }}
                  {% if finding.is_inference %}<span class="minor">ข้อสันนิษฐานเชิงวิเคราะห์</span>{% endif %}
                  {% if finding.source_check == "not_supported" %}<span class="minor">ตัวตรวจอัตโนมัติไม่พบว่า Source ที่อ้างรองรับข้อค้นพบนี้ ควรตรวจกับต้นฉบับ</span>{% endif %}
                </td>
                <td class="ref">
                  {{ finding.source_labels | join(", ") or "-" }}
                  {% if finding.contradicting_source_labels %}<span class="minor">ขัดแย้ง: {{ finding.contradicting_source_labels | join(", ") }}</span>{% endif %}
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p class="body">ยังไม่พบข้อเท็จจริงที่ผ่านการตรวจสอบจากผลการวิเคราะห์</p>
        {% endif %}
      </section>
