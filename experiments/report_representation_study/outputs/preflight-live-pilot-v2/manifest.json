          "source_spans": [
            {
              "char_end": 124,
              "char_start": 0,
              "content": "The first report states that the handle RedFox belongs to Carol V. and that RedFox sent the message at 2026-03-01 10:00 UTC.",
              "content_sha256": "b3531ae7c1ff58cd10085afdc881ce0754aa182aa6f8bf229e65525288d4d378",
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3",
              "source_type": "incident_report"
            },
            {
              "char_end": 159,
              "char_start": 0,
              "content": "A witness instead says that RedFox may refer to Carla V. and recalls the message at approximately 2026-03-01 11:00 UTC. The witness says the time is uncertain.",
