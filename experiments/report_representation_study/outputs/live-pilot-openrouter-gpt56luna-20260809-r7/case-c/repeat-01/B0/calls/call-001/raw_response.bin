            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-010",
          "text": "The first report identifies RedFox as Carol V.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-011",
          "text": "The witness says RedFox may refer to Carla V.",
          "statement_type": "case_statement",
          "epistemic_status": "suspected",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-012",
          "text": "The supplied sources do not resolve whether the RedFox handle was used by Carol V., Carla V., or another unresolved counterpart.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "unknown_counterpart",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
