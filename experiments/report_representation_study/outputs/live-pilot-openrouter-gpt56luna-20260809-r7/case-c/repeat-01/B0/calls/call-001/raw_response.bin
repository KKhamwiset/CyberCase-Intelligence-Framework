      "section_id": "executive_summary",
      "heading": "Executive Summary",
      "content": [
        {
          "statement_id": "stmt-001",
          "text": "The first report states that the RedFox handle belongs to Carol V.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-002",
          "text": "A witness says that RedFox may refer to Carla V.",
          "statement_type": "case_statement",
          "epistemic_status": "suspected",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-003",
          "text": "The sources provide conflicting reported identities for the RedFox handle.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "conflicting_sources",
          "source_refs": [
