{
  "report_version": "representation_study_report_v1",
  "status": "provisional_unverified",
  "case_id": "case-c",
  "title": "Provisional Investigative Report: case-c",
  "sections": [
    {
      "section_id": "executive_summary",
      "heading": "Executive Summary",
      "content": [
        {
          "statement_id": "stmt-001",
          "text": "The first report states that the RedFox handle sent a message.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-002",
          "text": "The identity of the person represented by the RedFox handle remains unresolved between Carol V. and Carla V.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "conflicting_sources",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            },
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-003",
          "text": "The reported message time is inconsistent across the two accounts.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "conflicting_sources",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            },
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "case_background_scope",
      "heading": "Case Background and Scope",
      "content": [
        {
          "statement_id": "stmt-004",
          "text": "The supplied case representation contains a handle named RedFox and two separately named person entities, Carol V. and Carla V.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            },
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-005",
          "text": "The supplied representation does not establish whether Carol V. and Carla V. are the same person.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            },
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "evidence_findings",
      "heading": "Evidence Findings",
      "content": [
        {
          "statement_id": "stmt-006",
          "text": "The first report states that RedFox belongs to Carol V.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-007",
          "text": "The witness says that RedFox may refer to Carla V.",
          "statement_type": "case_statement",
          "epistemic_status": "suspected",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-008",
          "text": "The first report places the message at 2026-03-01 10:00 UTC.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-009",
          "text": "The witness recalls the message at approximately 2026-03-01 11:00 UTC and states that the time is uncertain.",
          "statement_type": "case_statement",
          "epistemic_status": "suspected",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "individuals_accounts_systems_roles",
      "heading": "Individuals, Accounts, Systems, and Reported Roles",
      "content": [
        {
          "statement_id": "stmt-010",
          "text": "RedFox is represented as a handle.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            },
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-011",
          "text": "The first report identifies Carol V. as the person to whom RedFox belongs.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-012",
          "text": "The witness presents Carla V. as a possible referent of RedFox.",
          "statement_type": "case_statement",
          "epistemic_status": "suspected",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-013",
          "text": "The supplied sources do not resolve the coreference between RedFox, Carol V., and Carla V.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "conflicting_sources",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            },
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "chronological_timeline",
      "heading": "Chronological Timeline",
      "content": [
        {
          "statement_id": "stmt-014",
          "text": "The first report states that RedFox sent a message at 2026-03-01 10:00 UTC.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-015",
          "text": "The witness recalls that RedFox sent a message at approximately 2026-03-01 11:00 UTC.",
          "statement_type": "case_statement",
          "epistemic_status": "suspected",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-016",
          "text": "The witness states that the recalled message time is uncertain.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-017",
          "text": "The supplied sources do not establish a single message time.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "conflicting_sources",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c/report/paragraph-3"
            },
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "technical_analysis_mitre",
      "heading": "Technical Analysis and MITRE ATT&CK Mapping",
      "content": [
        {
          "statement_id": "stmt-018",
          "text": "The supplied representation records a message sent by the RedFox handle but does not provide sufficient technical detail for an ATT&CK technique mapping.",
