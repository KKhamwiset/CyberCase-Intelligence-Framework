_established","mitre_technique_ids":[],"reference_ids":[],"source_refs":[{"source_id":"a-message-001","source_locator":"case-a-scale/message-export/message-77"}],"statement_id":"timeline-003","statement_type":"uncertainty_or_gap","text":"The message-export index expressly does not establish that its collection date was the incident date."},{"epistemic_status":"reported","mitre_technique_ids":[],"reference_ids":[],"source_refs":[{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}],"statement_id":"timeline-004","statement_type":"case_statement","text":"A provider request for account-holder information associated with ACC-200 was sent after transaction review began."},{"epistemic_status":"missing_information","mitre_technique_ids":[],"reference_ids":[ ],"source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}],"statement_id":"timeline-005","statement_type":"uncertainty_or_gap","text":"The intake statement has no timestamp showing when it was made."}],"heading":"Chronological Timeline","section_id":"chronological_timeline"},{"content":[{"epistemic_status":"not_established","mitre_technique_ids":[],"reference_ids":[],"source_refs":[{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"},{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}],"statement_id":"tech-001","statement_type":"analysis_candidate","text":"A provider-side authentication and device review could test whether a session associated with TX-1 was authenticated through a device or context linked to ACC-100; the supplied records do not establish that linkage."},{"epistemic_status":"not_applicable","mitre_technique_ids":[],"reference_ids":[],"source_refs":[],"statement_id":"tech-002","statement_type":"limitation","text":"No MITRE ATT&CK technique mapping is asserted because the supplied records describe a transfer and evidence gaps without establishing a qualifying adversary behavior."}],"heading":"Technical Analysis and MITRE ATT&CK Mapping","section_id":"technical_analysis_mitre"},{"content":[{"epistemic_status":"not_established","mitre_technique_ids":[],"reference_ids":[],"source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"},{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"statement_id":"conclusion-001","statement_type":"case_statement","text":"The supplied records support a reported settled transfer identified as TX-1 from ACC-100 to ACC-200 for USD 500 at 2026-01-10 09:00 UTC."},{"epistemic_status":"not_established","mitre_technique_ids":[],"reference_ids":[],"source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"},{"source_id":"a-account-001","source_locator":"case-a-scale/account-registry/record-100"},{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}],"statement_id":"conclusion-002","statement_type":"uncertainty_or_gap","text":"The supplied records do not establish that Alice Chen controlled the session or device used for TX-1."},{"epistemic_status":"missing_evidence","mitre_technique_ids":[],"reference_ids":[],"source_refs":[{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"},{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}],"statement_id":"conclusion-003","statement_type":"uncertainty_or_gap","text":"Provider-side authentication records and destination-account holder information are missing from the case packet."},{"epistemic_status":"not_applicable","mitre_technique_ids":[],"reference_ids":[],"source_refs":[],"statement_id":"next-001","statement_type":"next_step","text":"Preserve the original intake statement, ledger exports, detailed transaction export, reconciliation note, device inventory, message-export index, and provider-request records in their original form."},{"epistemic_status":"not_applicable","mitre_technique_ids":[],"reference_ids":[],"source_refs":[],"statement_id":"next-002","statement_type":"next_step","text":"Request provider account records for ACC-100 and ACC-200, including available ownership, controller, verification, and audit metadata."},{"epistemic_status":"not_applicable","mitre_technique_ids":[],"reference_ids":[],"source_refs":[],"statement_id":"next-003","statement_type":"next_step","text":"Request login, authentication, session, and device telemetry for the TX-1 transaction window and assess whether the records link any authenticated session to Alice Chen or device D-17."},{"epistemic_status":"not_applicable","mitre_technique_ids":[],"reference_ids":[],"source_refs":[],"statement_id":"next-004","statement_type":"next_step","text":"Verify whether ACC-200 has a provider-verified controller and document any response or nonresponse to the outstanding provider request."}],"heading":"Conclusions, Limitations, and Recommended Next Investigative Steps","section_id":"conclusions_limitations_next_steps"}],"status":"provisional_unverified","title":"Provisional Investigative Report: case-a-scale"}