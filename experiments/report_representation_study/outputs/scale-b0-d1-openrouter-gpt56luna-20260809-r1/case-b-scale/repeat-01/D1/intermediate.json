          ],
          "source_refs": [
            {
              "source_id": "b-interview-001",
              "source_locator": "case-b-scale/interview/bob/paragraph-2"
            }
          ],
          "summary": "The interview summary identifies Bob Niran as a person mentioned during the interview, but investigators state that the available information does not establish that he controls account ACC-B1 and does not verify him as its account holder.",
          "timestamp_text": null
        },
        {
          "participants": [
            "ACC-B1",
            "Bob Niran"
