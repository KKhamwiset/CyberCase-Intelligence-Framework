          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-support-001",
              "source_locator": "case-b-scale/service-desk/ticket-44"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-006",
          "text": "The service-desk ticket did not show authenticated access to ACC-B1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "b-support-001",
              "source_locator": "case-b-scale/service-desk/ticket-44"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-007",
          "text": "An email header included Bob Niran as a visible sender name in a discussion about account access.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-email-001",
              "source_locator": "case-b-scale/email/header-17"
