          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-008",
          "text": "The email header did not provide verified account-control or authentication context.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "b-email-001",
              "source_locator": "case-b-scale/email/header-17"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-009",
          "text": "A provider request sought registration, recovery, and login records for ACC-B1.",
