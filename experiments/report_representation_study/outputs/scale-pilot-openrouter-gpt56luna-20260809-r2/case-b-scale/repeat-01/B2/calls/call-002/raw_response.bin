    {
      "section_id": "evidence_findings",
      "heading": "Evidence Findings",
      "content": [
        {
          "statement_id": "stmt-005",
          "text": "A service-desk ticket used a contact name matching Bob Niran and asked about access to a partially redacted account identifier.",
