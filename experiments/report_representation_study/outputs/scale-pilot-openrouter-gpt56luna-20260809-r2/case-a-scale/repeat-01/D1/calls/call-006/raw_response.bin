{"report_version":"representation_study_report_v1","status":"provisional_unverified","case_id":"case-a-scale","title":"Provisional Investigative Report: case-a-scale","sections":[{"section_id":"executive_summary","heading":"Executive Summary","content":[{"statement_id":"stmt-001","text":"The intake statement reports that Alice Chen is the registered holder of account ACC-100.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-002","text":"Transaction TX-1 is reported as a settled USD 500 transfer from ACC-100 to ACC-200 at 2026-01-10 09:00 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-003","text":"The supplied records do not establish the owner or controller of ACC-200.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_information","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"},{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"case_background_scope","heading":"Case Background and Scope","content":[{"statement_id":"stmt-004","text":"The case packet includes an intake statement, ledger exports, account-registry information, device inventory, a message-export index, provider-request records, and review notes.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-admin-001","source_locator":"case-a-scale/administration/packet-index"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-005","text":"The packet index does not certify the accuracy of the listed records or add identity, ownership, or chronology evidence.","statement_type":"limitation","epistemic_status":"not_applicable","source_refs":[{"source_id":"a-admin-001","source_locator":"case-a-scale/administration/packet-index"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-006","text":"The operations record listed in the supplied material is administrative context and is not treated as an incident fact.","statement_type":"limitation","epistemic_status":"not_applicable","source_refs":[{"source_id":"a-ops-001","source_locator":"case-a-scale/operations/relay-maintenance"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"evidence_findings","heading":"Evidence Findings","content":[{"statement_id":"stmt-007","text":"The account-registry excerpt lists ACC-100 as active and repeats the display name Alice Chen.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-account-001","source_locator":"case-a-scale/account-registry/record-100"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-008","text":"The account-registry excerpt does not show the underlying identity-verification result, the date of last verification, or a provider signature.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_evidence","source_refs":[{"source_id":"a-account-001","source_locator":"case-a-scale/account-registry/record-100"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-009","text":"A detailed transaction export records TX-1 as settled for USD 500 from ACC-100 to ACC-200.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-010","text":"The detailed transaction export does not identify a beneficiary person, beneficiary organization, or controller for ACC-200.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_information","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-011","text":"The reconciliation note states that two transaction exports appear to refer to the same TX-1 record.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-003","source_locator":"case-a-scale/ledger/reconciliation-note"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-012","text":"The reconciliation note warns that the duplicate exports should not be counted as separate transfers.","statement_type":"analysis_candidate","epistemic_status":"not_established","source_refs":[{"source_id":"a-ledger-003","source_locator":"case-a-scale/ledger/reconciliation-note"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-013","text":"Login and authentication audit records for the transaction window were not included in the case packet.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_evidence","source_refs":[{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"individuals_accounts_systems_roles","heading":"Individuals, Accounts, Systems, and Reported Roles","content":[{"statement_id":"stmt-014","text":"Alice Chen is identified in the intake statement as the reported registered holder of ACC-100.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-015","text":"The transaction record names Alice Chen as the initiating user for TX-1.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-016","text":"The supplied records do not independently confirm that Alice Chen owned or controlled ACC-100.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_evidence","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"},{"source_id":"a-account-001","source_locator":"case-a-scale/account-registry/record-100"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-017","text":"Device D-17 is listed as observed in the same administrative account context as ACC-100.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-018","text":"The device inventory does not establish that Alice Chen operated D-17 during TX-1.","statement_type":"uncertainty_or_gap","epistemic_status":"not_established","source_refs":[{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-019","text":"The supplied records do not identify the owner or controller of ACC-200.","statement_type":"uncertainty_or_gap","epistemic_status":"unknown_counterpart","source_refs":[{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"},{"source_id":"a-memo-001","source_locator":"case-a-scale/memo/paragraph-2"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"chronological_timeline","heading":"Chronological Timeline","content":[{"statement_id":"stmt-020","text":"TX-1 is recorded at 2026-01-10 09:00 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-021","text":"The detailed transaction export repeats 2026-01-10 09:00 UTC for TX-1.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-022","text":"The message-export index was collected on 2026-01-12.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-message-001","source_locator":"case-a-scale/message-export/message-77"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-023","text":"The message-export collection date is not established as the incident time.","statement_type":"limitation","epistemic_status":"not_applicable","source_refs":[{"source_id":"a-message-001","source_locator":"case-a-scale/message-export/message-77"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-024","text":"The provider request for account-holder information associated with ACC-200 was sent after transaction review began.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-025","text":"The supplied records do not provide a timestamp for when the intake statement was made.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_information","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"technical_analysis_mitre","heading":"Technical Analysis and MITRE ATT&CK Mapping","content":[{"statement_id":"stmt-026","text":"The supplied records document a financial-account transfer but do not establish the authentication activity that produced it.","statement_type":"analysis_candidate","epistemic_status":"not_established","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"},{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-027","text":"No MITRE ATT&CK technique mapping is asserted because the supplied records do not provide sufficient source-supported technical behavior for a mapping.","statement_type":"limitation","epistemic_status":"not_applicable","source_refs":[{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-028","text":"The device inventory does not contain an authenticated session identifier linking D-17 to TX-1.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_evidence","source_refs":[{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"conclusions_limitations_next_steps","heading":"Conclusions, Limitations, and Recommended Next Investigative Steps","content":[{"statement_id":"stmt-029","text":"The current packet supports a reported relationship between Alice Chen and ACC-100 but does not independently verify that relationship.","statement_type":"analysis_candidate","epistemic_status":"not_established","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"},{"source_id":"a-account-001","source_locator":"case-a-scale/account-registry/record-100"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-030","text":"The current packet supports one reported TX-1 transfer event from ACC-100 to ACC-200 for USD 500 at 2026-01-10 09:00 UTC.","statement_type":"analysis_candidate","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"},{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"},{"source_id":"a-ledger-003","source_locator":"case-a-scale/ledger/reconciliation-note"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-031","text":"The relationship between ACC-200 and any person or organization remains unresolved in the supplied material.","statement_type":"uncertainty_or_gap","epistemic_status":"unknown_counterpart","source_refs":[{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"},{"source_id":"a-memo-001","source_locator":"case-a-scale/memo/paragraph-2"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-032","text":"Preserve the original intake statement and ledger exports before further review or transformation.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[{"source_id":"a-review-001","source_locator":"case-a-scale/review/verification-plan"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-033","text":"Obtain provider-side account records for ACC-100 and ACC-200 to verify account relationships and the destination-account controller.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[{"source_id":"a-review-001","source_locator":"case-a-scale/review/verification-plan"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-034","text":"Request login, authentication, and device telemetry for the TX-1 transaction window.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[{"source_id":"a-review-001","source_locator":"case-a-scale/review/verification-plan"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-035","text":"Check whether ACC-200 has a verified controller using provider records or other authorized account evidence.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[{"source_id":"a-review-001","source_locator":"case-a-scale/review/verification-plan"}],"reference_ids":[],"mitre_technique_ids":[]}]}]}