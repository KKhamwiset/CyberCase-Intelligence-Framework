ant_role":"owner_or_controller","missing_role":"object","description":"The owner or controller of ACC-200 is relevant to the reported transfer but is not stably identified in the packet.","derivation":"explicit_source","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"},{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"},{"source_id":"a-memo-001","source_locator":"case-a-scale/memo/paragraph-2"},{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}]},{"gap_id":"gap-tx1-authenticated-operator","known_entity_id":"ent-acc-100","predicate_or_participant_role":"authenticated operator during TX-1","missing_role":"participant","description":"The authenticated person or account operator for ACC-100 during TX-1 is not established by the packet; naming Alice Chen as initiating user is not an authenticated session proof.","derivation":"explicit_source","source_refs":[{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"},{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}]}],"missing_evidence":[{"gap_id":"gap-login-auth-records","description":"Login and authentication audit records for the transaction window are absent; the provider request has no attached response.","derivation":"explicit_source","context_event_ids":["evt-transfer-tx1"],"known_entity_ids":["ent-acc-100","ent-acc-200"],"source_refs":[{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"}]},{"gap_id":"gap-destination-account-records","description":"Provider-side account-holder information and controller records for ACC-200 are absent.","derivation":"explicit_source","context_event_ids":["evt-transfer-tx1"],"known_entity_ids":["ent-acc-200"],"source_refs":[{"source_id":"a-memo-001","source_locator":"case-a-scale/memo/paragraph-2"},{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}]},{"gap_id":"gap-device-session-telemetry","description":"Authenticated device telemetry or a session identifier linking D-17 to TX-1 is absent.","derivation":"explicit_source","context_event_ids":["evt-transfer-tx1"],"known_entity_ids":["ent-device-d17","ent-acc-100"],"source_refs":[{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}]}],"missing_information":[{"gap_id":"gap-statement-time","description":"The intake statement has no timestamp for when it was made.","derivation":"explicit_source","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}]},{"gap_id":"gap-acc100-verification-details","description":"The packet lacks the underlying identity-verification result, date of last verification, and provider signature for the ACC-100 registry assertion.","derivation":"explicit_source","known_entity_ids":["ent-acc-100","ent-alice-chen"],"source_refs":[{"source_id":"a-account-001","source_locator":"case-a-scale/account-registry/record-100"}]},{"gap_id":"gap-verification-completion","description":"Provider account records, authentication records, login and device telemetry, and destination-controller checks should be obtained or performed to verify the reported account relationship and transfer attribution.","derivation":"frozen_case_mandate","context_event_ids":["evt-transfer-tx1"],"known_entity_ids":["ent-alice-chen","ent-acc-100","ent-acc-200","ent-device-d17"],"source_refs":[]}],"conflicts":[],"warnings":["The two ledger exports are treated as support for one TX-1 event because the reconciliation note says they refer to the same record; they are not counted as separate transfers.","The message-export collection date is provenance information and is not used as the transfer incident time.","The relay-server maintenance entry and office-supplies invoice are unrelated records and were not promoted to incident facts.","The reported Alice Chen–ACC-100 holder relationship and the initiating-user field are preserved as source assertions, not verified ownership or attribution."]}