          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-022",
          "text": "The routine software maintenance entry does not mention TX-1, ACC-100, ACC-200, Alice Chen, or account activity.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [
            {
              "source_id": "a-ops-001",
              "source_locator": "case-a-scale/operations/relay-maintenance"
