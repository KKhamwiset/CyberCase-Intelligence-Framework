    {
      "section_id": "conclusions_limitations_next_steps",
      "heading": "Conclusions, Limitations, and Recommended Next Investigative Steps",
      "content": [
        {
          "statement_id": "stmt-026",
          "text": "The packet supports a reported relationship between Alice Chen and ACC-100 but does not independently verify ownership.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "a-statement-001",
              "source_locator": "case-a-scale/statement/line-1"
            },
            {
              "source_id": "a-account-001",
              "source_locator": "case-a-scale/account-registry/record-100"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-027",
          "text": "The packet supports one reported TX-1 transfer event involving USD 500 from ACC-100 to ACC-200 at 2026-01-10 09:00 UTC.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-ledger-001",
              "source_locator": "case-a-scale/ledger/transaction-TX-1"
            },
            {
              "source_id": "a-ledger-002",
              "source_locator": "case-a-scale/ledger/transaction-TX-1-detail"
            },
            {
              "source_id": "a-ledger-003",
              "source_locator": "case-a-scale/ledger/reconciliation-note"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-028",
          "text": "The packet does not establish the identity or control of the destination account counterpart.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "a-memo-001",
              "source_locator": "case-a-scale/memo/paragraph-2"
            },
            {
              "source_id": "a-support-001",
              "source_locator": "case-a-scale/provider-request/request-200"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-029",
          "text": "Preserve the original intake statement and ledger exports without alteration.",
          "statement_type": "next_step",
          "epistemic_status": "not_applicable",
          "source_refs": [],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-030",
          "text": "Request provider-side account records for ACC-100 and ACC-200.",
          "statement_type": "next_step",
          "epistemic_status": "not_applicable",
          "source_refs": [],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-031",
          "text": "Request login, authentication, session, and device telemetry for the TX-1 transaction window.",
          "statement_type": "next_step",
          "epistemic_status": "not_applicable",
          "source_refs": [],
