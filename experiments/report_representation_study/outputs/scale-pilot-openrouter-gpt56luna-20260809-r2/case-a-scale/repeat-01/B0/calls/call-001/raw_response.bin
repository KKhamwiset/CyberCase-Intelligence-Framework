        },
        {
          "statement_id": "stmt-024",
          "text": "The packet does not include an authenticated session identifier linking D-17 to TX-1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "a-device-001",
