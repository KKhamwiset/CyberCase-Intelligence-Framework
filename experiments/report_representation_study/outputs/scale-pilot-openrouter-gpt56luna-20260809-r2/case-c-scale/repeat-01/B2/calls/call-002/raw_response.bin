{"report_version":"representation_study_report_v1","status":"provisional_unverified","case_id":"case-c-scale","title":"Provisional Investigative Report: case-c-scale","sections":[{"section_id":"executive_summary","heading":"Executive Summary","content":[{"statement_id":"stmt-001","text":"The first report states that the RedFox handle belongs to Carol V.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-report-001","source_locator":"case-c-scale/report/paragraph-3"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-002","text":"A witness states that RedFox may refer to Carla V.","statement_type":"case_statement","epistemic_status":"suspected","source_refs":[{"source_id":"c-witness-001","source_locator":"case-c-scale/witness/paragraph-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-003","text":"The packet does not establish whether Carol V. and Carla V. are aliases or distinct individuals.","statement_type":"uncertainty_or_gap","epistemic_status":"conflicting_sources","source_refs":[{"source_id":"c-analyst-001","source_locator":"case-c-scale/analysis/coreference-note"},{"source_id":"c-alias-001","source_locator":"case-c-scale/analysis/alias-table"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-004","text":"The packet contains conflicting reported times of 2026-03-01 10:00 UTC and approximately 2026-03-01 11:00 UTC for the message.","statement_type":"uncertainty_or_gap","epistemic_status":"conflicting_sources","source_refs":[{"source_id":"c-report-001","source_locator":"case-c-scale/report/paragraph-3"},{"source_id":"c-witness-001","source_locator":"case-c-scale/witness/paragraph-1"},{"source_id":"c-chronology-001","source_locator":"case-c-scale/analysis/chronology-review"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"case_background_scope","heading":"Case Background and Scope","content":[{"statement_id":"stmt-005","text":"The supplied packet concerns the RedFox handle and message M-77.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-platform-001","source_locator":"case-c-scale/platform/handle-export/redfox"},{"source_id":"c-message-001","source_locator":"case-c-scale/message/metadata/message-77"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-006","text":"This report preserves source claims and unresolved conflicts without selecting a canonical identity for RedFox.","statement_type":"limitation","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-007","text":"The message metadata records a collection-side timestamp rather than a reliable sent-at timestamp.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-message-001","source_locator":"case-c-scale/message/metadata/message-77"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"evidence_findings","heading":"Evidence Findings","content":[{"statement_id":"stmt-008","text":"The platform export confirms that a handle named RedFox appeared in the relevant message thread.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-platform-001","source_locator":"case-c-scale/platform/handle-export/redfox"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-009","text":"The platform export redacts account identifier and ownership fields.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-platform-001","source_locator":"case-c-scale/platform/handle-export/redfox"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-010","text":"The supplied profile excerpt uses the display name Carol V. and contains a denial of knowledge of the RedFox message.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-profile-001","source_locator":"case-c-scale/profile/carol-v"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-011","text":"The supplied Carol V. profile excerpt is not authenticated to the RedFox platform account.","statement_type":"missing_evidence","epistemic_status":"missing_evidence","source_refs":[{"source_id":"c-profile-001","source_locator":"case-c-scale/profile/carol-v"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-012","text":"The platform request for account identifier, registration details, and message send metadata has no response in the packet.","statement_type":"missing_evidence","epistemic_status":"missing_evidence","source_refs":[{"source_id":"c-platform-002","source_locator":"case-c-scale/platform/request/account-mapping"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-013","text":"The preservation log records collection of the platform export at 2026-03-04 15:20 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-preservation-001","source_locator":"case-c-scale/preservation/export-01"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"individuals_accounts_systems_roles","heading":"Individuals, Accounts, Systems, and Reported Roles","content":[{"statement_id":"stmt-014","text":"RedFox is consistently identified in the packet as a handle appearing in the relevant thread.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-report-001","source_locator":"case-c-scale/report/paragraph-3"},{"source_id":"c-witness-001","source_locator":"case-c-scale/witness/paragraph-1"},{"source_id":"c-platform-001","source_locator":"case-c-scale/platform/handle-export/redfox"},{"source_id":"c-chat-001","source_locator":"case-c-scale/chat/thread-12"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-015","text":"The first report asserts that RedFox is controlled by Carol V.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-report-001","source_locator":"case-c-scale/report/paragraph-3"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-016","text":"The witness states that RedFox may refer to Carla V.","statement_type":"analysis_candidate","epistemic_status":"suspected","source_refs":[{"source_id":"c-witness-001","source_locator":"case-c-scale/witness/paragraph-1"},{"source_id":"c-witness-002","source_locator":"case-c-scale/witness/addendum-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-017","text":"The packet does not identify the verified controller of RedFox.","statement_type":"uncertainty_or_gap","epistemic_status":"unknown_counterpart","source_refs":[{"source_id":"c-platform-001","source_locator":"case-c-scale/platform/handle-export/redfox"},{"source_id":"c-platform-002","source_locator":"case-c-scale/platform/request/account-mapping"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-018","text":"The analyst note recommends obtaining platform account records before selecting a canonical identity for Carol V. or Carla V.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-analyst-001","source_locator":"case-c-scale/analysis/coreference-note"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"chronological_timeline","heading":"Chronological Timeline","content":[{"statement_id":"stmt-019","text":"The first report places the message at 2026-03-01 10:00 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-report-001","source_locator":"case-c-scale/report/paragraph-3"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-020","text":"The witness recalls the message at approximately 2026-03-01 11:00 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-witness-001","source_locator":"case-c-scale/witness/paragraph-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-021","text":"The exact incident time for message M-77 remains unresolved because reliable platform send metadata is absent.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_evidence","source_refs":[{"source_id":"c-message-001","source_locator":"case-c-scale/message/metadata/message-77"},{"source_id":"c-platform-002","source_locator":"case-c-scale/platform/request/account-mapping"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-022","text":"The platform export was collected at 2026-03-04 15:20 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"c-preservation-001","source_locator":"case-c-scale/preservation/export-01"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-023","text":"The collection time is distinct from the unresolved incident time.","statement_type":"limitation","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"technical_analysis_mitre","heading":"Technical Analysis and MITRE ATT&CK Mapping","content":[{"statement_id":"stmt-024","text":"The packet establishes the presence of the RedFox handle in a relevant message thread but does not establish verified account ownership.","statement_type":"analysis_candidate","epistemic_status":"not_established","source_refs":[{"source_id":"c-platform-001","source_locator":"case-c-scale/platform/handle-export/redfox"},{"source_id":"c-platform-002","source_locator":"case-c-scale/platform/request/account-mapping"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-025","text":"No MITRE ATT&CK technique mapping is supported by the supplied representation and frozen reference context.","statement_type":"limitation","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-026","text":"The message metadata does not provide reliable sent-at data for technical chronology analysis.","statement_type":"missing_evidence","epistemic_status":"missing_evidence","source_refs":[{"source_id":"c-message-001","source_locator":"case-c-scale/message/metadata/message-77"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"conclusions_limitations_next_steps","heading":"Conclusions, Limitations, and Recommended Next Investigative Steps","content":[{"statement_id":"stmt-027","text":"The packet does not support choosing between Carol V. and Carla V. as the person associated with RedFox.","statement_type":"uncertainty_or_gap","epistemic_status":"conflicting_sources","source_refs":[{"source_id":"c-report-001","source_locator":"case-c-scale/report/paragraph-3"},{"source_id":"c-witness-001","source_locator":"case-c-scale/witness/paragraph-1"},{"source_id":"c-analyst-001","source_locator":"case-c-scale/analysis/coreference-note"},{"source_id":"c-alias-001","source_locator":"case-c-scale/analysis/alias-table"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-028","text":"The packet does not support choosing between 2026-03-01 10:00 UTC and approximately 2026-03-01 11:00 UTC as the exact message time.","statement_type":"uncertainty_or_gap","epistemic_status":"conflicting_sources","source_refs":[{"source_id":"c-report-001","source_locator":"case-c-scale/report/paragraph-3"},{"source_id":"c-witness-001","source_locator":"case-c-scale/witness/paragraph-1"},{"source_id":"c-chronology-001","source_locator":"case-c-scale/analysis/chronology-review"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-029","text":"Obtain and preserve the platform account identifier and ownership or registration records for RedFox.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-030","text":"Obtain and preserve reliable platform send metadata for RedFox and message M-77.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-031","text":"Compare any obtained platform records with the Carol V. and Carla V. source materials before making a coreference determination.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]}]}]}