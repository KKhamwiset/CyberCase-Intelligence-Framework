    {
      "section_id": "chronological_timeline",
      "heading": "Chronological Timeline",
      "content": [
        {
          "statement_id": "stmt-020",
          "text": "The account-registry excerpt records a creation date for ACC-B1, but the supplied source content does not state that date.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "b-registry-001",
              "source_locator": "case-b-scale/account-registry/acc-b1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-021",
          "text": "A witness recalls Bob Niran discussing an account problem during a meeting.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-witness-001",
              "source_locator": "case-b-scale/witness/paragraph-4"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-022",
          "text": "The witness cannot identify the account number discussed during the meeting.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "b-witness-001",
              "source_locator": "case-b-scale/witness/paragraph-4"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-023",
          "text": "The supplied sources do not provide a complete chronology of account creation, access, or relevant events for ACC-B1.",
          "statement_type": "limitation",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "b-audit-001",
              "source_locator": "case-b-scale/evidence-request/login-audit"
