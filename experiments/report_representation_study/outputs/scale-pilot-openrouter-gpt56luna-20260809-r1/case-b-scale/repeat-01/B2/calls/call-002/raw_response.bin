        }
      ]
    },
    {
      "section_id": "evidence_findings",
      "heading": "Evidence Findings",
      "content": [
        {
          "statement_id": "stmt-005",
          "text": "An interview mentioned Bob Niran in connection with ACC-B1 without establishing that he controls the account.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-interview-001",
              "source_locator": "case-b-scale/interview/bob/paragraph-2"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-006",
          "text": "A service-desk ticket used a contact name matching Bob Niran and asked about access to a partially redacted account identifier.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-support-001",
              "source_locator": "case-b-scale/service-desk/ticket-44"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-007",
          "text": "The service-desk ticket does not show authenticated access to ACC-B1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "b-support-001",
              "source_locator": "case-b-scale/service-desk/ticket-44"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-008",
          "text": "An email header included Bob Niran as a visible sender name in a discussion about account access.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-email-001",
              "source_locator": "case-b-scale/email/header-17"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-009",
          "text": "The email header does not establish control of ACC-B1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "b-email-001",
              "source_locator": "case-b-scale/email/header-17"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-010",
          "text": "Laptop B-17 was listed as issued to Bob Niran.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-device-001",
              "source_locator": "case-b-scale/device-inventory/laptop-B17"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-011",
          "text": "No session record links laptop B-17 to ACC-B1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "b-device-001",
              "source_locator": "case-b-scale/device-inventory/laptop-B17"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-012",
          "text": "A witness recalled Bob discussing an account problem during a meeting.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-witness-001",
              "source_locator": "case-b-scale/witness/paragraph-4"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-013",
          "text": "The witness could not identify the account number or say that Bob logged into ACC-B1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "b-witness-001",
              "source_locator": "case-b-scale/witness/paragraph-4"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-014",
          "text": "A provider request sought registration, recovery, and login records for ACC-B1.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "b-provider-001",
              "source_locator": "case-b-scale/provider-request/request-acc-b1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-015",
          "text": "The provider request remains unanswered in the supplied packet.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "b-provider-001",
              "source_locator": "case-b-scale/provider-request/request-acc-b1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
