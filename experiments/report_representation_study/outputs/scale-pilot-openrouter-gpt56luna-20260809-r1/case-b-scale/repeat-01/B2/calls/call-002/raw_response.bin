    {
      "section_id": "case_background_scope",
      "heading": "Case Background and Scope",
      "content": [
        {
          "statement_id": "stmt-003",
          "text": "This report is limited to the supplied representation concerning Bob Niran, account ACC-B1, associated records, and the unresolved control relationship.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-004",
          "text": "The account registry does not provide an owner, controller, identity-verification record, customer identifier, or provider signature for ACC-B1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "b-registry-001",
              "source_locator": "case-b-scale/account-registry/acc-b1"
