            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-002",
          "text": "The owner or controller of ACC-B1 remains unknown.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "unknown_counterpart",
          "source_refs": [
