      "section_id": "executive_summary",
      "heading": "Executive Summary",
      "content": [
        {
          "statement_id": "stmt-001",
          "text": "The available information does not establish that Bob Niran controls account ACC-B1.",
          "statement_type": "case_statement",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "b-analyst-001",
              "source_locator": "case-b-scale/analysis/control-status"
            },
            {
              "source_id": "b-interview-001",
