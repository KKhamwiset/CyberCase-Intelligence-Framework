{
  "report_version": "representation_study_report_v1",
  "status": "provisional_unverified",
  "case_id": "case-c-scale",
  "title": "Provisional Investigative Report: case-c-scale",
  "sections": [
    {
      "section_id": "executive_summary",
      "heading": "Executive Summary",
      "content": [
        {
          "statement_id": "stmt-001",
          "text": "The first report identifies the RedFox handle with Carol V. and places the message at 2026-03-01 10:00 UTC as the reporting party's account.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c-scale/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-002",
          "text": "A witness instead associates RedFox with Carla V. and recalls the message at approximately 2026-03-01 11:00 UTC.",
          "statement_type": "case_statement",
          "epistemic_status": "conflicting_sources",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c-scale/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-003",
          "text": "The packet does not establish whether Carol V. or Carla V. controlled the RedFox handle.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "c-platform-001",
              "source_locator": "case-c-scale/platform/handle-export/redfox"
            },
            {
              "source_id": "c-analyst-001",
              "source_locator": "case-c-scale/analysis/coreference-note"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "case_background_scope",
      "heading": "Case Background and Scope",
      "content": [
        {
          "statement_id": "stmt-004",
          "text": "The packet concerns a message thread containing a handle named RedFox and a message identified as M-77.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-platform-001",
              "source_locator": "case-c-scale/platform/handle-export/redfox"
            },
            {
              "source_id": "c-message-001",
              "source_locator": "case-c-scale/message/metadata/message-77"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-005",
          "text": "The supplied platform export confirms the presence of the RedFox handle in the relevant message thread.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-platform-001",
              "source_locator": "case-c-scale/platform/handle-export/redfox"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-006",
          "text": "The report does not include a platform ownership record for RedFox.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c-scale/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "evidence_findings",
      "heading": "Evidence Findings",
      "content": [
        {
          "statement_id": "stmt-007",
          "text": "The platform export's account identifier and ownership fields are redacted.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-platform-001",
              "source_locator": "case-c-scale/platform/handle-export/redfox"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-008",
          "text": "Message metadata identifies the message as M-77.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-message-001",
              "source_locator": "case-c-scale/message/metadata/message-77"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-009",
          "text": "Message metadata records a collection-side timestamp of 2026-03-01 11:02 UTC.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-message-001",
              "source_locator": "case-c-scale/message/metadata/message-77"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-010",
          "text": "The metadata does not provide a reliable sent-at timestamp.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "c-message-001",
              "source_locator": "case-c-scale/message/metadata/message-77"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-011",
          "text": "The preservation log records collection of the platform export on 2026-03-04 15:20 UTC under evidence package E-01.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-preservation-001",
              "source_locator": "case-c-scale/preservation/export-01"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-012",
          "text": "The preservation record does not establish when the message was sent.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "c-preservation-001",
              "source_locator": "case-c-scale/preservation/export-01"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-013",
          "text": "The supplied profile excerpt displays the name Carol V.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-profile-001",
              "source_locator": "case-c-scale/profile/carol-v"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-014",
          "text": "The profile excerpt contains a sentence denying knowledge of the RedFox message.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-profile-001",
              "source_locator": "case-c-scale/profile/carol-v"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-015",
          "text": "The profile excerpt is not authenticated to the platform account in the packet.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "c-profile-001",
              "source_locator": "case-c-scale/profile/carol-v"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "individuals_accounts_systems_roles",
      "heading": "Individuals, Accounts, Systems, and Reported Roles",
      "content": [
        {
          "statement_id": "stmt-016",
          "text": "The first report names Carol V. as the person associated with RedFox.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c-scale/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-017",
          "text": "The witness materials associate the name Carla V. with RedFox but do not confirm that Carla V. used the handle.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c-scale/witness/paragraph-1"
            },
            {
              "source_id": "c-witness-002",
              "source_locator": "case-c-scale/witness/addendum-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-018",
          "text": "The analyst note states that Carol V. and Carla V. may be aliases for one person or may be distinct individuals.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "unknown_counterpart",
          "source_refs": [
            {
              "source_id": "c-analyst-001",
              "source_locator": "case-c-scale/analysis/coreference-note"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-019",
          "text": "The identity comparison note warns that spelling similarity is insufficient to establish coreference.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "c-alias-001",
              "source_locator": "case-c-scale/analysis/alias-table"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-020",
          "text": "The chat transcript shows a participant using the name RedFox.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-chat-001",
              "source_locator": "case-c-scale/chat/thread-12"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-021",
          "text": "The chat transcript does not directly identify the RedFox participant as Carol V. or Carla V.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "c-chat-001",
              "source_locator": "case-c-scale/chat/thread-12"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "chronological_timeline",
      "heading": "Chronological Timeline",
      "content": [
        {
          "statement_id": "stmt-022",
          "text": "The first report places the message at 2026-03-01 10:00 UTC.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-report-001",
              "source_locator": "case-c-scale/report/paragraph-3"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-023",
          "text": "The witness account places the message at approximately 2026-03-01 11:00 UTC and describes the time as uncertain.",
          "statement_type": "case_statement",
          "epistemic_status": "conflicting_sources",
          "source_refs": [
            {
              "source_id": "c-witness-001",
              "source_locator": "case-c-scale/witness/paragraph-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-024",
          "text": "The chronology review records the 10:00 UTC and approximately 11:00 UTC descriptions as incompatible time claims.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "conflicting_sources",
          "source_refs": [
            {
              "source_id": "c-chronology-001",
              "source_locator": "case-c-scale/analysis/chronology-review"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-025",
          "text": "The metadata timestamp of 2026-03-01 11:02 UTC is identified as a collection-side timestamp rather than a reliable sent-at timestamp.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-message-001",
              "source_locator": "case-c-scale/message/metadata/message-77"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-026",
          "text": "The platform export was collected on 2026-03-04 15:20 UTC.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-preservation-001",
              "source_locator": "case-c-scale/preservation/export-01"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-027",
          "text": "The 2026-03-02 maintenance log does not mention RedFox, M-77, Carol V., Carla V., or the reported message.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [
            {
              "source_id": "c-ops-001",
              "source_locator": "case-c-scale/unrelated/maintenance-window"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "technical_analysis_mitre",
      "heading": "Technical Analysis and MITRE ATT&CK Mapping",
      "content": [
        {
          "statement_id": "stmt-028",
          "text": "The platform export supports the presence of the RedFox handle but not attribution of the handle to either named person.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "c-platform-001",
              "source_locator": "case-c-scale/platform/handle-export/redfox"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-029",
          "text": "The platform request seeks the account identifier, registration details, and message send metadata for RedFox and M-77.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "c-platform-002",
              "source_locator": "case-c-scale/platform/request/account-mapping"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-030",
          "text": "The platform request has no response in the supplied packet.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "c-platform-002",
              "source_locator": "case-c-scale/platform/request/account-mapping"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-031",
          "text": "The supplied incident sources do not support a specific MITRE ATT&CK technique mapping.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "conclusions_limitations_next_steps",
      "heading": "Conclusions, Limitations, and Recommended Next Investigative Steps",
      "content": [
        {
          "statement_id": "stmt-032",
          "text": "The identity of the person controlling RedFox remains unresolved.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "c-analyst-001",
              "source_locator": "case-c-scale/analysis/coreference-note"
            },
            {
              "source_id": "c-platform-001",
              "source_locator": "case-c-scale/platform/handle-export/redfox"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-033",
          "text": "The exact sent-at time of message M-77 remains unresolved.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "c-message-001",
              "source_locator": "case-c-scale/message/metadata/message-77"
            },
            {
              "source_id": "c-chronology-001",
              "source_locator": "case-c-scale/analysis/chronology-review"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-034",
          "text": "Obtain the platform account identifier and ownership records for RedFox before selecting a canonical identity.",
          "statement_type": "next_step",
          "epistemic_status": "not_applicable",
          "source_refs": [],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-035",
          "text": "Obtain authoritative platform send metadata for message M-77 and compare it with the reported times.",
          "statement_type": "next_step",
          "epistemic_status": "not_applicable",
          "source_refs": [],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-036",
          "text": "Preserve the platform export, message metadata, witness materials, transcript, and associated chain-of-custody records for further review.",
          "statement_type": "next_step",
          "epistemic_status": "not_applicable",
          "source_refs": [],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    }
  ]
}