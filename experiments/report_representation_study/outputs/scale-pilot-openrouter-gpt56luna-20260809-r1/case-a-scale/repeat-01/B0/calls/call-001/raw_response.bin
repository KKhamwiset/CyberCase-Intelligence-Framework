          "text": "The message-export collection date is not the incident or transaction date.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [
            {
              "source_id": "a-message-001",
              "source_locator": "case-a-scale/message-export/message-77"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-022",
          "text": "The provider request for ACC-200 account-holder information was sent after the transaction review began.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-support-001",
              "source_locator": "case-a-scale/provider-request/request-200"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-023",
          "text": "Routine relay-server maintenance was recorded on 2026-01-11.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [
            {
              "source_id": "a-ops-001",
              "source_locator": "case-a-scale/operations/relay-maintenance"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-024",
          "text": "The packet does not provide a timestamp for when the intake statement was made.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "a-statement-001",
