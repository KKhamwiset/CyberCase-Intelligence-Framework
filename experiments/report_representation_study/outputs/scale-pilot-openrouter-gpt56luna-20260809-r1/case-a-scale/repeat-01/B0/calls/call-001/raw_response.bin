  "title": "Provisional Investigative Report: case-a-scale",
  "sections": [
    {
      "section_id": "executive_summary",
      "heading": "Executive Summary",
      "content": [
        {
          "statement_id": "stmt-001",
          "text": "The intake statement reports that Alice Chen is the registered holder of account ACC-100.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-statement-001",
              "source_locator": "case-a-scale/statement/line-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-002",
          "text": "Transaction record TX-1 reports a USD 500 transfer from ACC-100 to ACC-200 at 2026-01-10 09:00 UTC.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-ledger-001",
              "source_locator": "case-a-scale/ledger/transaction-TX-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-003",
          "text": "The packet does not establish the owner or controller of ACC-200.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_information",
          "source_refs": [
            {
              "source_id": "a-ledger-002",
              "source_locator": "case-a-scale/ledger/transaction-TX-1-detail"
            },
            {
              "source_id": "a-memo-001",
              "source_locator": "case-a-scale/memo/paragraph-2"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "case_background_scope",
      "heading": "Case Background and Scope",
      "content": [
        {
          "statement_id": "stmt-004",
          "text": "The mandate is to describe the reported account relationship, transfer event, involved entities, supporting and limiting records, chronology, and verification steps.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-005",
          "text": "The packet index does not certify the accuracy of the included records.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [
            {
              "source_id": "a-admin-001",
              "source_locator": "case-a-scale/administration/packet-index"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-006",
          "text": "The office-supplies invoice is unrelated to the reported transfer and should not be used as an incident finding.",
          "statement_type": "limitation",
          "epistemic_status": "not_applicable",
          "source_refs": [
            {
              "source_id": "a-finance-001",
              "source_locator": "case-a-scale/unrelated/office-invoice"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "evidence_findings",
      "heading": "Evidence Findings",
      "content": [
        {
          "statement_id": "stmt-007",
          "text": "The account-registry excerpt lists ACC-100 as active and repeats the display name Alice Chen.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-account-001",
              "source_locator": "case-a-scale/account-registry/record-100"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-008",
          "text": "The account-registry excerpt does not show the underlying identity-verification result, the date of the last verification, or a provider signature.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "a-account-001",
              "source_locator": "case-a-scale/account-registry/record-100"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-009",
          "text": "The detailed TX-1 export records settled status, an amount of USD 500, source account ACC-100, destination account ACC-200, and an internal processing reference.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-ledger-002",
              "source_locator": "case-a-scale/ledger/transaction-TX-1-detail"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-010",
          "text": "The two transaction exports appear to refer to the same TX-1 record rather than two separate transfers.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-ledger-003",
              "source_locator": "case-a-scale/ledger/reconciliation-note"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-011",
          "text": "Login and authentication audit records for the transaction window are absent from the packet.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "a-auth-001",
              "source_locator": "case-a-scale/evidence-request/login-audit"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-012",
          "text": "No provider response to the request for account-holder information associated with ACC-200 is included in the packet.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "a-support-001",
              "source_locator": "case-a-scale/provider-request/request-200"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
    {
      "section_id": "individuals_accounts_systems_roles",
      "heading": "Individuals, Accounts, Systems, and Reported Roles",
      "content": [
        {
          "statement_id": "stmt-013",
          "text": "Alice Chen is reported as the holder of ACC-100.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-statement-001",
              "source_locator": "case-a-scale/statement/line-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-014",
          "text": "The TX-1 transaction record names Alice Chen as the initiating user.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-ledger-001",
              "source_locator": "case-a-scale/ledger/transaction-TX-1"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-015",
          "text": "The transaction records identify ACC-100 as the source account and ACC-200 as the destination account.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-ledger-001",
              "source_locator": "case-a-scale/ledger/transaction-TX-1"
            },
            {
              "source_id": "a-ledger-002",
              "source_locator": "case-a-scale/ledger/transaction-TX-1-detail"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-016",
          "text": "The packet does not identify a beneficiary person, beneficiary organization, or controller for ACC-200.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "unknown_counterpart",
          "source_refs": [
            {
              "source_id": "a-ledger-002",
              "source_locator": "case-a-scale/ledger/transaction-TX-1-detail"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-017",
          "text": "Device D-17 was observed in the same administrative account context as ACC-100.",
          "statement_type": "case_statement",
          "epistemic_status": "reported",
          "source_refs": [
            {
              "source_id": "a-device-001",
              "source_locator": "case-a-scale/device-inventory/device-D17"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-018",
          "text": "The device inventory does not establish that Alice Chen operated D-17 during TX-1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "a-device-001",
              "source_locator": "case-a-scale/device-inventory/device-D17"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        }
      ]
    },
