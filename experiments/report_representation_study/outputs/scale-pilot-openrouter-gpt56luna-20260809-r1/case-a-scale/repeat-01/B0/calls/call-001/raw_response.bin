    {
      "section_id": "technical_analysis_mitre",
      "heading": "Technical Analysis and MITRE ATT&CK Mapping",
      "content": [
        {
          "statement_id": "stmt-025",
          "text": "The available records support analysis of a reported account-to-account transfer but do not establish how the transaction was authenticated.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "a-ledger-001",
              "source_locator": "case-a-scale/ledger/transaction-TX-1"
            },
            {
              "source_id": "a-auth-001",
              "source_locator": "case-a-scale/evidence-request/login-audit"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-026",
          "text": "No MITRE ATT&CK technique mapping is supported by the supplied records.",
          "statement_type": "analysis_candidate",
          "epistemic_status": "not_established",
          "source_refs": [
            {
              "source_id": "a-auth-001",
              "source_locator": "case-a-scale/evidence-request/login-audit"
            },
            {
              "source_id": "a-device-001",
              "source_locator": "case-a-scale/device-inventory/device-D17"
            }
          ],
          "reference_ids": [],
          "mitre_technique_ids": []
        },
        {
          "statement_id": "stmt-027",
          "text": "The available device record does not provide an authenticated session identifier linking D-17 to TX-1.",
          "statement_type": "uncertainty_or_gap",
          "epistemic_status": "missing_evidence",
          "source_refs": [
            {
              "source_id": "a-device-001",
              "source_locator": "case-a-scale/device-inventory/device-D17"
