{"report_version":"representation_study_report_v1","status":"provisional_unverified","case_id":"case-a-scale","title":"Provisional Investigative Report: case-a-scale","sections":[{"section_id":"executive_summary","heading":"Executive Summary","content":[{"statement_id":"stmt-001","text":"The intake statement reports that Alice Chen is the registered holder of account ACC-100.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-002","text":"Transaction record TX-1 reports a USD 500 transfer from ACC-100 to ACC-200 at 2026-01-10 09:00 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"},{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-003","text":"The current packet does not establish the owner or controller of ACC-200.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_information","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"},{"source_id":"a-memo-001","source_locator":"case-a-scale/memo/paragraph-2"},{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"case_background_scope","heading":"Case Background and Scope","content":[{"statement_id":"stmt-004","text":"The supplied records concern a reported relationship between Alice Chen and ACC-100 and a reported transfer involving ACC-100 and ACC-200.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"},{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-005","text":"The intake statement does not include independent account-provider confirmation of the reported ACC-100 relationship.","statement_type":"limitation","epistemic_status":"missing_evidence","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-006","text":"The account-registry excerpt does not show the underlying identity-verification result, the date of last verification, or a provider signature.","statement_type":"limitation","epistemic_status":"missing_evidence","source_refs":[{"source_id":"a-account-001","source_locator":"case-a-scale/account-registry/record-100"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"evidence_findings","heading":"Evidence Findings","content":[{"statement_id":"stmt-007","text":"A detailed transaction export records TX-1 as settled for USD 500 from ACC-100 to ACC-200.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-008","text":"The detailed transaction export includes an internal processing reference.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-009","text":"The available transaction records name Alice Chen as the initiating user for TX-1.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-010","text":"The available transaction records do not identify a beneficiary person, beneficiary organization, or controller for ACC-200.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_information","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"},{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-011","text":"A reconciliation note characterizes two transaction exports as referring to the same TX-1 record rather than documenting a second transfer.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-003","source_locator":"case-a-scale/ledger/reconciliation-note"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-012","text":"Login and authentication audit records for the transaction window are not included in the case packet.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_evidence","source_refs":[{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"individuals_accounts_systems_roles","heading":"Individuals, Accounts, Systems, and Reported Roles","content":[{"statement_id":"stmt-013","text":"The intake statement reports Alice Chen as the registered holder of ACC-100.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-014","text":"The account-registry excerpt lists ACC-100 as active and repeats the display name Alice Chen.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-account-001","source_locator":"case-a-scale/account-registry/record-100"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-015","text":"The transaction record identifies Alice Chen as the initiating user for TX-1.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-016","text":"The device inventory lists device D-17 in the same administrative account context as ACC-100.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-017","text":"The device inventory does not establish that Alice Chen operated D-17 during TX-1.","statement_type":"uncertainty_or_gap","epistemic_status":"not_established","source_refs":[{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-018","text":"The current packet does not identify the holder or controller of ACC-200.","statement_type":"uncertainty_or_gap","epistemic_status":"unknown_counterpart","source_refs":[{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"},{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"chronological_timeline","heading":"Chronological Timeline","content":[{"statement_id":"stmt-019","text":"TX-1 is recorded at 2026-01-10 09:00 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"},{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-020","text":"A message-export index states that its collection occurred on 2026-01-12.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-message-001","source_locator":"case-a-scale/message-export/message-77"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-021","text":"The message-export index cautions that its collection time is not incident time.","statement_type":"limitation","epistemic_status":"reported","source_refs":[{"source_id":"a-message-001","source_locator":"case-a-scale/message-export/message-77"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-022","text":"The provider request for account-holder information associated with ACC-200 was recorded as unanswered after transaction review began.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-023","text":"The supplied records do not provide a timestamp for when the intake statement was made.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_information","source_refs":[{"source_id":"a-statement-001","source_locator":"case-a-scale/statement/line-1"}],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"technical_analysis_mitre","heading":"Technical Analysis and MITRE ATT&CK Mapping","content":[{"statement_id":"stmt-024","text":"The available records document a transaction and administrative account context but do not establish how TX-1 was authenticated.","statement_type":"analysis_candidate","epistemic_status":"not_established","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"},{"source_id":"a-auth-001","source_locator":"case-a-scale/evidence-request/login-audit"},{"source_id":"a-device-001","source_locator":"case-a-scale/device-inventory/device-D17"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-025","text":"No MITRE ATT&CK technique mapping is supported by the supplied records and frozen reference context.","statement_type":"limitation","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]}]},{"section_id":"conclusions_limitations_next_steps","heading":"Conclusions, Limitations, and Recommended Next Investigative Steps","content":[{"statement_id":"stmt-026","text":"The supplied records support a provisional report that TX-1 was recorded as a settled USD 500 transfer from ACC-100 to ACC-200 at 2026-01-10 09:00 UTC.","statement_type":"case_statement","epistemic_status":"reported","source_refs":[{"source_id":"a-ledger-001","source_locator":"case-a-scale/ledger/transaction-TX-1"},{"source_id":"a-ledger-002","source_locator":"case-a-scale/ledger/transaction-TX-1-detail"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-027","text":"The supplied records do not establish the verified controller of ACC-200.","statement_type":"uncertainty_or_gap","epistemic_status":"missing_information","source_refs":[{"source_id":"a-memo-001","source_locator":"case-a-scale/memo/paragraph-2"},{"source_id":"a-support-001","source_locator":"case-a-scale/provider-request/request-200"}],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-028","text":"Investigators should preserve the original intake statement and ledger exports.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-029","text":"Investigators should obtain provider-side account records for ACC-100 and ACC-200.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-030","text":"Investigators should request login, authentication, and device telemetry for the TX-1 transaction window.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]},{"statement_id":"stmt-031","text":"Investigators should verify whether ACC-200 has a verified controller.","statement_type":"next_step","epistemic_status":"not_applicable","source_refs":[],"reference_ids":[],"mitre_technique_ids":[]}]}]}